{
  "name": "guardrail-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p sdk && tsc -p scripts/testnet && tsc -p x402-demo",
    "test:contracts": "cargo test --manifest-path contracts/allowlist-policy/Cargo.toml",
    "test:unit": "node --test sdk/test/unit.test.ts x402-demo/facilitator.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local --test --test-concurrency=1 scripts/testnet/e2e.test.ts",
    "demo": "node --env-file-if-exists=.env.local scripts/testnet/demo.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/stellar": "2.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "express": "5.2.1",
    "smart-account-kit": "0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
